# OpenSSL FIPS Configuration
# FIPS 140-2 Level 3 Compliant

# Enable FIPS mode
openssl_conf = openssl_init

[openssl_init]
providers = provider_sect
alg_section = algorithm_sect

[provider_sect]
fips = fips_sect
base = base_sect

[base_sect]
activate = 1

[fips_sect]
activate = 1
conditional-errors = 1
security-checks = 1

[algorithm_sect]
default_properties = fips=yes

# FIPS Approved Algorithms Only
# RSA: 2048, 3072, 4096 bits
# ECDSA: P-256, P-384, P-521 curves
# AES: 128, 192, 256 bits
# SHA: SHA-256, SHA-384, SHA-512
# HMAC: HMAC-SHA256, HMAC-SHA384, HMAC-SHA512

# Random Number Generator
[rand]
random = random_sect

[random_sect]
random-provider = fips

# Certificate Signing
[req]
default_bits = 2048
default_keyfile = privkey.pem
distinguished_name = req_distinguished_name
attributes = req_attributes
x509_extensions = v3_ca

[req_distinguished_name]
countryName = Country Name (2 letter code)
countryName_default = IT
stateOrProvinceName = State or Province Name (full name)
stateOrProvinceName_default = Rome
localityName = Locality Name (eg, city)
localityName_default = Rome
organizationName = Organization Name (eg, company)
organizationName_default = CertTrust
organizationalUnitName = Organizational Unit Name (eg, section)
commonName = Common Name (eg, your name or your server\'s hostname)
commonName_max = 64
emailAddress = Email Address
emailAddress_max = 64

[req_attributes]
challengePassword = A challenge password
challengePassword_min = 4
challengePassword_max = 20

[v3_ca]
subjectKeyIdentifier = hash
authorityKeyIdentifier = keyid:always,issuer
basicConstraints = critical, CA:true
keyUsage = critical, digitalSignature, cRLSign, keyCertSign

[v3_intermediate_ca]
subjectKeyIdentifier = hash
authorityKeyIdentifier = keyid:always,issuer
basicConstraints = critical, CA:true, pathlen:0
keyUsage = critical, digitalSignature, cRLSign, keyCertSign

[server_cert]
basicConstraints = CA:FALSE
nsCertType = server
nsComment = "OpenSSL Generated Server Certificate"
subjectKeyIdentifier = hash
authorityKeyIdentifier = keyid,issuer:always
keyUsage = critical, digitalSignature, keyEncipherment
extendedKeyUsage = serverAuth

[client_cert]
basicConstraints = CA:FALSE
nsCertType = client, email
nsComment = "OpenSSL Generated Client Certificate"
subjectKeyIdentifier = hash
authorityKeyIdentifier = keyid,issuer
keyUsage = critical, nonRepudiation, digitalSignature, keyEncipherment
extendedKeyUsage = clientAuth, emailProtection

# PSD2 Certificate Extensions
[psd2_cert]
basicConstraints = CA:FALSE
keyUsage = critical, digitalSignature, keyEncipherment
extendedKeyUsage = serverAuth, clientAuth
1.3.6.1.4.1.311.20.2 = ASN1:UTF8:PSP_IC
1.3.6.1.4.1.311.20.2 = ASN1:UTF8:PSP_PI
subjectKeyIdentifier = hash
authorityKeyIdentifier = keyid,issuer:always

# QWAC Certificate Extensions
[qwac_cert]
basicConstraints = CA:FALSE
keyUsage = critical, digitalSignature, keyEncipherment
extendedKeyUsage = serverAuth
subjectAltName = @alt_names
subjectKeyIdentifier = hash
authorityKeyIdentifier = keyid,issuer:always

[alt_names]
DNS.1 = example.com
DNS.2 = www.example.com

# eIDAS Certificate Extensions
[eidas_cert]
basicConstraints = CA:FALSE
keyUsage = critical, digitalSignature, nonRepudiation, keyEncipherment
extendedKeyUsage = serverAuth, clientAuth, emailProtection
subjectKeyIdentifier = hash
authorityKeyIdentifier = keyid,issuer:always

# Audit Logging
[audit]
audit_enabled = 1
audit_log_path = /var/log/certtrust/audit.log
audit_retention_days = 365
audit_format = json
